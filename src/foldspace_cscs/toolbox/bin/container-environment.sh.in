#!/usr/bin/env bash
# Resolve foldspace-cscs's --environment VALUE on the @@CLUSTER@@ login node,
# and print the absolute path of the EDF the job will use. VALUE is either
#
#   - an EDF, as for Slurm's --environment: an absolute path, a ./relative
#     path (from $HOME, where jobs are submitted), or a name found in
#     $EDF_PATH or ~/.edf (without .toml); or
#   - a container image, e.g. ghcr.io/ltpn/matlab:r2026a or ubuntu:24.04.
#     A small EDF is then written to ~/.edf/foldspace-cscs-<image>.toml,
#     mounting $SCRATCH, $STORE and $HOME.
#
# An existing EDF with that name wins over an image with the same name.
#
# Either way, the EDF's image is pulled into the Container Engine's cache now
# if it is not there yet: a first pull inside the job (minutes, for large
# images) takes longer than Foldspace waits for the server to start.
set -euo pipefail
value=$1

edf=
case $value in
  /*)  edf=$value ;;
  ./*) edf=$HOME/${value#./} ;;
  *)   if [[ $value != */* && $value != *:* ]]; then
         IFS=: read -r -a dirs <<<"${EDF_PATH:-}"
         for d in "${dirs[@]}" "$HOME/.edf"; do
           [[ -n $d && -f $d/$value.toml ]] && { edf=$d/$value.toml; break; }
         done
       fi ;;
esac
if [[ -n $edf && ! -f $edf ]]; then
  echo "foldspace-cscs: no EDF file $value" >&2
  exit 2
fi

if [[ -z $edf ]]; then

  # An image reference: [REGISTRY/]NAME[:TAG], the way it is written in an EDF.
  if [[ ! $value =~ ^[A-Za-z0-9][A-Za-z0-9._/:#@+-]*$ ]]; then
    echo "foldspace-cscs: '$value' is neither an EDF nor a container image name" >&2
    exit 2
  fi
  name=foldspace-cscs-$(tr 'A-Z' 'a-z' <<<"$value" | sed -E 's/[^a-z0-9.]+/-/g; s/^-+|-+$//g')
  edf=$HOME/.edf/$name.toml
  mkdir -p "$HOME/.edf"
  mounts=()
  for var in SCRATCH STORE HOME; do
    [[ -n ${!var:-} && -d ${!var} ]] && mounts+=("\"\${$var}:\${$var}\"")
  done
  tmp=$(mktemp "$edf.XXXXXX")
  {
    echo "# Generated by foldspace-cscs for the image $value; rewritten on every use."
    echo "# Usable on its own too: srun --environment=$name ..."
    echo "image = \"$value\""
    echo "mounts = [$(IFS=,; sed 's/,/, /g' <<<"${mounts[*]}")]"
    echo 'workdir = "${HOME}"'
  } > "$tmp"
  mv "$tmp" "$edf"

fi

# The image, as written in the EDF (a plain string; a squashfs path, or one
# using ${VARIABLES}, is local: nothing to pull).
image=$(sed -n 's/^[[:space:]]*image[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' "$edf" | head -n 1)
store=${EDF_IMAGESTORE:-$SCRATCH/.edf_imagestore}
if [[ -n $image && $image != /* && $image != *'$'* && $store != void ]]; then
  # The Container Engine caches registry/name:tag as registry+name+tag.<arch>.sqsh
  # (a '#' registry separator is kept as is), so use the same file name.
  cached=$store/$(tr '/:' '++' <<<"$image").$(uname -m).sqsh
  # The same image written with the other registry separator ('/' or '#')
  first=${image%%/*}
  if [[ $image == *#* ]]; then other=${image/\#//}; else other=$first#${image#*/}; fi
  other_cached=$store/$(tr '/:' '++' <<<"$other").$(uname -m).sqsh
  if [[ ! -s $cached && -s $other_cached && $image == */* ]]; then
    ln "$other_cached" "$cached" 2>/dev/null || cp "$other_cached" "$cached"
  fi
  if [[ ! -s $cached ]]; then
    # enroot wants the registry separated by '#': ghcr.io/a/b -> ghcr.io#a/b
    ref=$image
    if [[ $image == */* && $image != *#* && ( $first == *.* || $first == *:* || $first == localhost ) ]]; then
      ref=$first#${image#*/}
    fi
    echo "→ Pulling $image into $store (first use only; large images take a while)" >&2
    mkdir -p "$store"
    rm -f "$cached.partial"
    enroot import -o "$cached.partial" "docker://$ref" >&2
    mv "$cached.partial" "$cached"
  fi
fi
echo "$edf"
