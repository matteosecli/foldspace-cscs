# Sourced by every tool's slurm.sh (generated by foldspace-cscs for @@CLUSTER@@).

# Session files (connection.yml, server configs): private to the user.
session_files_dir=@@USER_DIR@@/sessions/job_${SLURM_JOB_ID}-files
(
umask 077
mkdir -p "$session_files_dir"
)

# $HOME is shared between aarch64 (daint, clariden, santis) and x86_64
# (eiger) clusters: anything binary lives under an architecture prefix.
export arch=$(uname -m)
export FOLDSPACE_CSCS_PREFIX=$HOME/.local/$arch/foldspace-cscs

# Container (CSCS Container Engine). foldspace-cscs passes the EDF as
# FOLDSPACE_CSCS_EDF (an absolute path) instead of `#SBATCH --environment`,
# which CSCS discourages: the job script itself stays on the node, and only
# the server runs in the container, as a job step.
export FOLDSPACE_CSCS_EDF=${FOLDSPACE_CSCS_EDF:-}

# Run a command in the job's software environment: as is (the uenv, if any,
# is already mounted by Slurm), or as a job step in the container. The step
# gets the whole node, starts in the job's working directory (-D), and sees
# the foldspace-cscs files it needs even if the EDF does not mount $HOME.
in_job_environment () {
  if [[ -z $FOLDSPACE_CSCS_EDF ]]; then
    "$@"
    return
  fi
  local mounts=@@USER_DIR@@:@@USER_DIR@@
  local d
  for d in "$FOLDSPACE_CSCS_PREFIX" "$HOME/.local/$arch/share/vscode-web" "$HOME/.vscode-server"; do
    mkdir -p "$d" && mounts+=",$d:$d"
  done
  srun --overlap --nodes=1 --ntasks=1 --cpus-per-task="${SLURM_CPUS_ON_NODE:-1}" --cpu-bind=none \
       --environment="$FOLDSPACE_CSCS_EDF" --container-workdir="$PWD" --container-mounts="$mounts" "$@"
}
export -f in_job_environment

### -> JOB INFO (same wording as CINECA's toolboxes, adapted to Alps)
job_id=$SLURM_JOB_ID
job_end=$(date -d "@${SLURM_JOB_END_TIME:-0}" +"%H:%M %Z" 2>/dev/null || echo "?")
_scontrol=$(scontrol show job "$job_id" -o 2>/dev/null)
nodes=${SLURM_NNODES:-1}
nodelist=${SLURM_JOB_NODELIST:-$(hostname -s)}
tasks=${SLURM_NTASKS:-$(sed -n 's/.*NumTasks=\([0-9]*\).*/\1/p' <<<"$_scontrol")}; tasks=${tasks:-1}
# Alps nodes are allocated exclusively: report the CPUs Slurm actually gave,
# not the (default) 1 CPU per task that was requested.
if (( tasks > 1 )); then
  cpus=${SLURM_CPUS_PER_TASK:-$(sed -n 's/.*CPUs\/Task=\([0-9]*\).*/\1/p' <<<"$_scontrol")}
else
  cpus=${SLURM_CPUS_ON_NODE:-1}
fi
cpus=${cpus:-1}
gpus=${SLURM_GPUS_ON_NODE:-$(nvidia-smi -L 2>/dev/null | grep -c '^GPU')}; gpus=${gpus:-0}
account=${SLURM_JOB_ACCOUNT:-}
partition=${SLURM_JOB_PARTITION:-}
qos=${SLURM_JOB_QOS:-}
# uenv images and views mounted by Slurm (--uenv/--view), without the
# "@system%uarch" and "mount:uenv:" decorations
uenvs=$(uenv status 2>/dev/null | awk '$1=="image"{sub(/@.*/,"",$2); print $2}')
views=$(tr ',' '\n' <<<"${UENV_VIEW:-}" | awk -F: 'NF{print $NF}')

_plural() { (( $1 == 1 )) && echo "$2" || echo "$1 $3"; }
_join() { awk 'NF{a[n++]=$0} END{for(i=0;i<n;i++) printf "%s%s", a[i], (i<n-2?", ":(i==n-2?" and ":""))}'; }

_line1="Your job $job_id is running on {{ cluster_name }} using $(_plural "$nodes" "a single node" nodes) ($nodelist) with $(_plural "$tasks" "a single task" tasks) (using $(_plural "$cpus" "a single cpu" cpus)$( (( tasks > 1 )) && echo " each"))."
(( gpus > 0 )) && _line1+=" The job is using $(_plural "$gpus" "a single gpu" gpus)$( (( nodes > 1 )) && echo " per node")."
_line2="You are using ${account:+$account account on }$partition partition${qos:+ and $qos qos}"
if [[ -n $uenvs ]]; then
  _n=$(wc -l <<<"$uenvs")
  _line2+=", with the $(_join <<<"$uenvs") uenv$( (( _n > 1 )) && echo s)"
  [[ -n $views ]] && _line2+=" ($(_join <<<"$views") view$( (( $(wc -l <<<"$views") > 1 )) && echo s))"
fi
if [[ -n $FOLDSPACE_CSCS_EDF ]]; then
  _image=$(sed -n 's/^[[:space:]]*image[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$FOLDSPACE_CSCS_EDF" | head -n 1)
  _line2+=", in the ${_image:-$(basename "$FOLDSPACE_CSCS_EDF" .toml)} container"
fi
_line2+="."
job_info="$_line1
$_line2
If you need other details please run '[italic]scontrol show job $job_id[/italic]' on the cluster for a full overview of the job."
