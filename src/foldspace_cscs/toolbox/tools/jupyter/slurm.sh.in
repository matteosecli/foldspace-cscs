#!/bin/bash
#SBATCH --job-name=foldspace-cscs.jupyter
#SBATCH --output=@@USER_DIR@@/sessions/job_%j-output.log
#SBATCH --error=@@USER_DIR@@/sessions/job_%j-output.log
#SBATCH --nodes=1
#SBATCH --time=01:00:00
# Generated by foldspace-cscs for @@CLUSTER@@. Do not edit: overwritten on updates.
# The jupyterlab uenv (and the user's one, if any) is mounted by Slurm through
# the --uenv/--view options added by foldspace-cscs at submission.

export toolbox_dir=@@TOOLBOX_DIR@@
export tool_dir=$toolbox_dir/tools/jupyter
source "$toolbox_dir/tools/common.sh"

tool_info=$(cat <<EOT
You can connect to Jupyter Lab using the following url:

[dodger_blue1]http://127.0.0.1:{{ local_port }}/lab?token={{ token }}[/dodger_blue1]

until the job expires (at $job_end).
EOT
)

source "$toolbox_dir/tools/start_tool.sh"
