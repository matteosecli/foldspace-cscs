#!/bin/bash
#SBATCH --job-name=foldspace-cscs.vscode
#SBATCH --output=@@USER_DIR@@/sessions/job_%j-output.log
#SBATCH --error=@@USER_DIR@@/sessions/job_%j-output.log
#SBATCH --nodes=1
#SBATCH --time=01:00:00
# Generated by foldspace-cscs for @@CLUSTER@@. Do not edit: overwritten on updates.

export toolbox_dir=@@TOOLBOX_DIR@@
export tool_dir=$toolbox_dir/tools/vscode
source "$toolbox_dir/tools/common.sh"

# Opens VS Code desktop on this job (Remote-SSH, see bin/vscode-desktop-*.sh)
desktop_url=vscode://vscode-remote/ssh-remote+foldspace-cscs-@@CLUSTER@@$PWD

tool_info=$(cat <<EOT
You can connect to VS Code in your browser using the following url:

[dodger_blue1]http://127.0.0.1:{{ local_port }}/?tkn={{ token }}[/dodger_blue1]

or open it in VS Code desktop using the following link:

[dodger_blue1][link=$desktop_url]$desktop_url[/link][/dodger_blue1]

until the job expires (at $job_end).
EOT
)

source "$toolbox_dir/tools/start_tool.sh"
